# Starts the compose stack at boot and stops it cleanly. Containers restart themselves on failure
# (restart: unless-stopped); this unit restarts the stack if `docker compose up` itself fails.
# Install: sudo cp deploy/systemd/swinglock.service /etc/systemd/system/ && sudo systemctl enable --now swinglock
[Unit]
Description=Swing-lock scanner + dashboard (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/swinglock
# To enable the recorder and/or Caddy, add "--profile recorder" / "--profile public" right after
# "docker compose" on BOTH lines below (down only stops profiles it is told about).
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.yml up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.yml down
Restart=on-failure
RestartSec=30
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
