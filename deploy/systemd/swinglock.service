# Starts the compose stack at boot and stops it cleanly. Containers restart themselves on failure
# (restart: unless-stopped); this unit restarts the stack if `docker compose up` itself fails.
# Installed by deploy/bootstrap.sh. By hand: sudo cp deploy/systemd/swinglock.service /etc/systemd/system/ && sudo systemctl enable --now swinglock
[Unit]
Description=Swing-lock scanner + dashboard + recorder (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/swinglock
# Optional services: recorder on; add ",public" for the Caddy front (not needed with Tailscale).
Environment=COMPOSE_PROFILES=recorder
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.yml up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.yml down
Restart=on-failure
RestartSec=30
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
